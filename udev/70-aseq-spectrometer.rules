# ASEQ LR2 spectrometer (USB e220:0100): give the logged-in user access
# to the USB device (libusb backend) and its hidraw node (hidraw backend).
SUBSYSTEM=="usb", ATTRS{idVendor}=="e220", ATTRS{idProduct}=="0100", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="e220", ATTRS{idProduct}=="0100", TAG+="uaccess"
